@model RaceDayMVC.Services.CategoryData

@{
    ViewData["Title"] = "Create Race Category";
}

<div class="container mt-4">
    <h2>Create Race Category</h2>

    <form asp-action="CreateCategory" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="EventId">Event ID</label>
            <input asp-for="EventId" type="number" class="form-control" min="1" required />
        </div>

        <div class="mb-3">
            <label asp-for="Name">Category Name</label>
            <input asp-for="Name" class="form-control" required />
        </div>

        <div class="mb-3">
            <label asp-for="DistanceKm">Distance (KM)</label>
            <input asp-for="DistanceKm" type="number" step="0.1" class="form-control" min="0.01" required />
        </div>

        <div class="mb-3">
            <label asp-for="MaxParticipants">Maximum Participants</label>
            <input asp-for="MaxParticipants" type="number" class="form-control" min="1" required />
        </div>

        <div class="mb-3">
            <label asp-for="EntryFee">Entry Fee (R)</label>
            <input asp-for="EntryFee" type="number" step="0.01" class="form-control" min="0" required />
        </div>

        <div class="mb-3">
            <label asp-for="MinAge">Minimum Age</label>
            <input asp-for="MinAge" type="number" class="form-control" min="0" />
        </div>

        <div class="mb-3">
            <label asp-for="MaxAge">Maximum Age</label>
            <input asp-for="MaxAge" type="number" class="form-control" min="0" />
        </div>

        <button type="submit" class="btn btn-primary">Save Category</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
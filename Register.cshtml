@model IEnumerable<RaceDayMVC.Services.CategoryData>

@{
    ViewData["Title"] = "Register for Event";
    var raceEvent = ViewBag.Event;
}

<h2>Register for @raceEvent.Name</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!Model.Any())
{
    <p>No categories are available for this event yet.</p>
}
else
{
    <form asp-action="Register" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="eventId" value="@raceEvent.EventId" />

        <div class="mb-3">
            <label class="form-label">Select your race category</label>
            <select name="categoryId" class="form-select" required>
                <option value="">Choose a category</option>
                @foreach (var category in Model)
                {
                    <option value="@category.CategoryId">
                        @category.Name - @category.DistanceKm km
                        (R @category.EntryFee)
                    </option>
                }
            </select>
        </div>

        <button type="submit" class="btn btn-success">Confirm Registration</button>
        <a asp-action="Events" class="btn btn-secondary">Back</a>
    </form>
}
@model IEnumerable<RaceDayMVC.Services.EnrolmentData>

@{
    ViewData["Title"] = "My Events";
}

<h2 class="mb-4">My Registered Race Events</h2>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        You have not registered for any events yet.
    </div>
}
else
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Enrolment ID</th>
                <th>Event ID</th>
                <th>Category ID</th>
                <th>Registration Date</th>
                <th>Status</th>
                <th>Bib Number</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.EnrolmentId</td>
                    <td>@item.EventId</td>
                    <td>@item.CategoryId</td>
                    <td>@item.EnrolmentDate.ToString("dd MMM yyyy")</td>
                    <td>@item.Status</td>
                    <td>@(item.BibNumber?.ToString() ?? "Not assigned")</td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-controller="Participant" asp-action="Index"
   class="btn btn-secondary">Back to Dashboard</a>